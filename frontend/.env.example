# Copy to .env.local for local overrides, or set in Vercel Project Settings.
#
# Local development: leave VITE_API_BASE_URL unset. Requests stay relative
# and are proxied by Vite (see vite.config.ts) to http://localhost:8000.
#
# Production (Vercel): set this to the deployed backend's public origin,
# with no trailing slash, e.g.:
# VITE_API_BASE_URL=https://truthtrace-backend.example.com
VITE_API_BASE_URL=

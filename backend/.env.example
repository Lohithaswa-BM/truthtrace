# Copy to .env for local overrides (already gitignored), or set as secrets/
# environment variables in your hosting platform's dashboard. None of these
# are read by the frontend — they stay server-side.
#
# DATABASE_URL: defaults to a local SQLite file (backend/truthtrace.db) if
# unset. For any deployment where the filesystem is not guaranteed to
# persist between requests/restarts (e.g. serverless), point this at a
# managed database instead, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/truthtrace
DATABASE_URL=

# CORS_ORIGINS: JSON array of allowed frontend origins. Defaults to the
# local Vite dev server if unset. Set this to your deployed frontend's
# origin(s), e.g.:
# CORS_ORIGINS=["https://truthtrace.vercel.app"]
CORS_ORIGINS=

# STORAGE_DIR: local filesystem path for uploaded evidence files. Defaults
# to backend/app/storage. See DEPLOYMENT.md — this must point at
# persistent, writable storage in any non-local deployment.
STORAGE_DIR=
